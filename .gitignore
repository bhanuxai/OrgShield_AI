# ==============================================================================
# OrgShield AI - Git Exclusion Configuration (.gitignore)
# ==============================================================================

# Python Environments & Caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js & Frontend Builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets Configuration (allow .env.example templates)
.env
.env.*
!.env.example
!frontend/.env.example

# Local SQLite Databases & Transaction Journals (prevent committing local scan records)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
backend/app/database/*.db

# Large Datasets & Raw Mail Archives (Preserve on local disk; DO NOT track on GitHub)
enron_mail_*/
*.tar.gz
*.gz
*.zip
*.7z
*.rar
*.mbox
ml/data/external/

# Explicitly Preserve Required Production Model Artifacts & Evaluation Reports
!ml/models_store/
!ml/models_store/*
!ml/data/phishing_benchmark.json
!reports/
!reports/**

# Logs & Temporary Artifacts
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp

# OS Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
