# OrgShield AI Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage & Models
DATABASE_PATH=backend/app/database/orgshield.db
MODEL_DIR=ml/models_store
REPORTS_DIR=reports

# Dataset paths (relative to project root)
ENRON_DATASET_DIR=enron_mail_20150507_final/maildir
FALLBACK_ENRON_DIR=enron_mail_20150507/maildir

# ML Anomaly Thresholds & Tuning
# Calibrated threshold for One-Class SVM (99.0% legitimate specificity / 1.0% FPR)
DEFAULT_ANOMALY_THRESHOLD=0.7912
DEFAULT_MODEL=one_class_svm
MAX_EMAILS_PARSE_SAMPLE=15000
RANDOM_SEED=42
